<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.travel.mapper.GuideMapper">

    <resultMap id="GuideSummaryResultMap" type="com.travel.pojo.model.GuideSummary">
        <id column="id" property="id"/>
        <result column="destination_id" property="destinationId"/>
        <result column="author_id" property="authorId"/>
        <result column="title" property="title"/>
        <result column="summary" property="summary"/>
        <result column="cover_image_url" property="coverImageUrl"/>
        <result column="location_text" property="locationText"/>
        <result column="scope" property="scope"/>
        <result column="travel_mode" property="travelMode"/>
        <result column="published_at" property="publishedAt"/>
        <result column="days" property="days"/>
        <result column="budget_total" property="budgetTotal"/>
        <result column="views_count" property="viewsCount"/>
        <result column="likes_count" property="likesCount"/>
        <result column="comments_count" property="commentsCount"/>
        <result column="favorites_count" property="favoritesCount"/>
        <result column="destination_name" property="destinationName"/>
        <result column="author_name" property="authorName"/>
        <result column="author_avatar_url" property="authorAvatarUrl"/>
        <result column="status" property="status"/>
    </resultMap>

    <resultMap id="GuideDetailResultMap" type="com.travel.pojo.model.GuideDetail">
        <id column="id" property="id"/>
        <result column="destination_id" property="destinationId"/>
        <result column="author_id" property="authorId"/>
        <result column="title" property="title"/>
        <result column="summary" property="summary"/>
        <result column="content_html" property="contentHtml"/>
        <result column="cover_image_url" property="coverImageUrl"/>
        <result column="location_text" property="locationText"/>
        <result column="scope" property="scope"/>
        <result column="travel_mode" property="travelMode"/>
        <result column="published_at" property="publishedAt"/>
        <result column="days" property="days"/>
        <result column="budget_total" property="budgetTotal"/>
        <result column="views_count" property="viewsCount"/>
        <result column="likes_count" property="likesCount"/>
        <result column="comments_count" property="commentsCount"/>
        <result column="favorites_count" property="favoritesCount"/>
        <result column="destination_name" property="destinationName"/>
        <result column="author_name" property="authorName"/>
        <result column="author_avatar_url" property="authorAvatarUrl"/>
        <result column="status" property="status"/>
    </resultMap>

    <sql id="GuideSummaryColumns">
        SELECT g.id, g.destination_id, g.author_id, g.title, g.summary, g.cover_image_url, g.location_text, g.scope, g.travel_mode,
        g.published_at, g.days, g.budget_total, g.views_count, g.likes_count, g.comments_count, g.favorites_count, g.status,
        d.name AS destination_name,
        up.nickname AS author_name,
        up.avatar_url AS author_avatar_url
    </sql>

    <sql id="GuideSummaryJoins">
        FROM guides g
        LEFT JOIN destinations d ON d.id = g.destination_id
        LEFT JOIN user_profiles up ON up.user_id = g.author_id
    </sql>

    <sql id="GuideSummaryWhere">
        <where>
            g.publish_status = 'published'
            <if test="keyword != null and keyword != ''">
                AND (g.title LIKE CONCAT('%', #{keyword}, '%')
                     OR g.summary LIKE CONCAT('%', #{keyword}, '%')
                     OR g.content_html LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="scope != null and scope != ''">
                AND g.scope = #{scope}
            </if>
            <if test="travelMode != null and travelMode != ''">
                AND g.travel_mode = #{travelMode}
            </if>
        </where>
    </sql>

    <select id="listGuides" resultMap="GuideSummaryResultMap">
        <include refid="GuideSummaryColumns"/>
        <include refid="GuideSummaryJoins"/>
        <include refid="GuideSummaryWhere"/>
        <choose>
            <when test="sort == 'hot'">
                ORDER BY g.likes_count DESC, g.views_count DESC, g.id DESC
            </when>
            <otherwise>
                ORDER BY g.published_at DESC, g.id DESC
            </otherwise>
        </choose>
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="countGuides" resultType="long">
        SELECT COUNT(1)
        FROM guides g
        <include refid="GuideSummaryWhere"/>
    </select>

    <select id="listGuidesByDestination" resultMap="GuideSummaryResultMap">
        <include refid="GuideSummaryColumns"/>
        <include refid="GuideSummaryJoins"/>
        WHERE g.publish_status = 'published'
          AND g.destination_id = #{destinationId}
        ORDER BY g.published_at DESC, g.id DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="countGuidesByDestination" resultType="long">
        SELECT COUNT(1)
        FROM guides
        WHERE publish_status = 'published'
          AND destination_id = #{destinationId}
    </select>

    <select id="selectGuideDetail" resultMap="GuideDetailResultMap">
        <include refid="GuideSummaryColumns"/>,
        g.content_html
        <include refid="GuideSummaryJoins"/>
        WHERE g.id = #{guideId}
          AND g.publish_status = 'published'
    </select>

    <select id="listItineraryDays" resultType="com.travel.pojo.model.GuideItineraryDay">
        SELECT id, guide_id, day_no, title, summary, sort_order
        FROM guide_itinerary_days
        WHERE guide_id = #{guideId}
        ORDER BY day_no ASC
    </select>

    

    

    

    

    <select id="listCommunityPicks" resultMap="GuideSummaryResultMap">
        <include refid="GuideSummaryColumns"/>
        <include refid="GuideSummaryJoins"/>
        WHERE g.publish_status = 'published'
        ORDER BY g.likes_count DESC, g.views_count DESC, g.id DESC
        LIMIT #{limit}
    </select>

    <select id="listTopGuidesByLikes" resultMap="GuideSummaryResultMap">
        <include refid="GuideSummaryColumns"/>
        <include refid="GuideSummaryJoins"/>
        WHERE g.publish_status = 'published'
        ORDER BY g.likes_count DESC, g.id DESC
        LIMIT #{limit}
    </select>

    <select id="searchGuides" resultMap="GuideSummaryResultMap">
        <include refid="GuideSummaryColumns"/>
        <include refid="GuideSummaryJoins"/>
        WHERE g.publish_status = 'published'
          AND (g.title LIKE CONCAT('%', #{query}, '%')
               OR g.summary LIKE CONCAT('%', #{query}, '%')
               OR g.content_html LIKE CONCAT('%', #{query}, '%'))
        ORDER BY g.likes_count DESC, g.id DESC
        LIMIT #{limit}
    </select>

</mapper>

